{
  "crons": [
    {
      "path": "/api/star-live-refresh",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/starcraft.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}